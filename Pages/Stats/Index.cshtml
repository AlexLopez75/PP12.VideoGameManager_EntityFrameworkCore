@page
@model VideoGameManager.Pages.Stats.IndexModel
@{
    ViewData["Title"] = "Stats";
}

<h1>Stats</h1>

<h2 class="mb-4">Basic LINQ Queries (Task 6)</h2>

<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Genre filter (Ordered by Score)</h5>
    </div>
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end mb-4">
            <div class="col-auto">
                <label class="form-label">Select Genre:</label>
                <select asp-for="selectedGenre" asp-items="Model.Genres" class="form-select">
                    <option value="">-- All --</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Filter</button>
            </div>
        </form>

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Títol</th>
                    <th>Gènere</th>
                    <th>Puntuació</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var game in Model.FilteredGames)
                {
                    <tr>
                        <td>@game.Title</td>
                        <td>@game.Genre</td>
                        <td><span class="badge bg-info text-dark">@game.Score</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">Top 5 Best Rated Games</h5>
            </div>
            <div class="card-body">
                <ul class="list-group">
                    @foreach (var game in Model.Top5Games)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@game.Title</strong><br />
                                <small class="text-muted">Developer: @game.Developer?.Name</small>
                            </div>
                            <span class="badge bg-success rounded-pill">@game.Score</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Games  per Decade</h5>
            </div>
            <div class="card-body">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Decade</th>
                            <th>Number of Games</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.GamesPerDecade)
                        {
                            <tr>
                                <td>@entry.Key</td>
                                <td><strong>@entry.Value</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<hr class="my-5" />
<h2 class="mb-4">Advanced LINQ Queries (Task 7)</h2>

<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card h-100 shadow-sm border-info">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">Average score by Developer</h5>
            </div>
            <div class="card-body">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Developer</th>
                            <th>Number of games</th>
                            <th>Average Score</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dev in Model.AvgByDev)
                        {
                            <tr>
                                <td>@dev.Name</td>
                                <td>@dev.GameCount</td>
                                <td><span class="badge bg-secondary">@dev.AvgScore.ToString("0.00")</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card h-100 shadow-sm border-warning">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">Developers over the minimum number of games</h5>
            </div>
            <div class="card-body">
                <form method="get" class="row g-2 align-items-center mb-3">
                    <div class="col-auto">
                        <label>Minimum number of games (Threshold):</label>
                    </div>
                    <div class="col-auto">
                        <input type="number" asp-for="threshold" class="form-control form-control-sm" style="width: 80px;" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-warning btn-sm">Search</button>
                    </div>
                </form>

                <ul class="list-group">
                    @foreach (var dev in Model.ProductiveDevs)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            @dev.Name
                            <span class="badge bg-dark rounded-pill">@(dev.Games?.Count ?? 0) games</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="card mb-5 shadow-sm border-primary">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Combined search</h5>
    </div>
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end mb-4 bg-light p-3 rounded">
            <div class="col-md-3">
                <label class="form-label">Title (conté):</label>
                <input type="text" asp-for="titleFilter" class="form-control" placeholder="Ex: Zelda" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Genre:</label>
                <select asp-for="genreFilter" asp-items="Model.Genres" class="form-select">
                    <option value="">-- All --</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Minimum year:</label>
                <input type="number" asp-for="minYear" class="form-control" placeholder="Ex: 2010" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">Search Games</button>
            </div>
        </form>

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Developer</th>
                    <th>Genre</th>
                    <th>Year</th>
                    <th>Score</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Results.Any())
                {
                    @foreach (var game in Model.Results)
                    {
                        <tr>
                            <td><strong>@game.Title</strong></td>
                            <td>@game.Developer?.Name</td>
                            <td>@game.Genre</td>
                            <td>@game.Year</td>
                            <td><span class="badge bg-success">@game.Score</span></td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">No game matches these filters.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>