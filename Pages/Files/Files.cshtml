@page
@model VideoGameManager.Pages.Files.FilesModel
@{
    ViewData["Title"] = "Files";
}

<h1>Files</h1>

<div class="mb-5 mt-4">

    <h3>Export / Import (JSON)</h3>
    <p class="card-text text-muted">Save the current state of the game list or retrieve a previous one.</p>
    
    <form method="post">
        <button type="submit" asp-page-handler="Export" class="btn btn-success me-2">Export to JSON</button>
        <button type="submit" asp-page-handler="Import" class="btn btn-warning">Import from JSON</button>
    </form>

    <h3><i class="bi bi-filetype-csv"></i>CSV Format</h3>
    <p class="card-text text-muted">Ideal for opening in Excel or external tools.</p>
    
    <form method="post">
        <button type="submit" asp-page-handler="ExportCsv" class="btn btn-success me-2">
            <i class="bi bi-download"></i> Download CSV
        </button>
        <button type="submit" asp-page-handler="ImportCsv" class="btn btn-warning">Import CSV</button>
    </form>

    <h3><i class="bi bi-filetype-xml"></i>XML Ranking</h3>
    <p class="card-text text-muted">Generate an XML file with the games ordered by score (Top score).</p>
    <form method="post">
        <button type="submit" asp-page-handler="GenerateXml" class="btn btn-success me-2">
            <i class="bi bi-download"></i> Generate games_ranking.xml
        </button>
    </form>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-info mt-3">
            @Model.Message
        </div>
    }

</div>

<hr />

<div>
    <h3>Activity Log</h3>
    <div class="bg-light p-3 border rounded" style="max-height: 300px; overflow-y: auto;">
        @if (Model.LogEntries.Length == 0)
        {
            <p>No log entries found.</p>
        }
        else
        {
            <ul>
                @foreach (var entry in Model.LogEntries)
                {
                    <li>@entry</li>
                }
            </ul>
        }
    </div>
</div>