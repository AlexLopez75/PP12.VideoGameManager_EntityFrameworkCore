@page "{id:int}"
@model VideoGameManager.Pages.Games.DeleteModel
@{
    ViewData["Title"] = "Delete";
}

<h1>Delete game</h1>

<div>
    <h4>Are you sure you want to delete this game?</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Title
        </dt>
        <dd class = "col-sm-10">
            @Model.Game.Title
        </dd>
        <dt class="col-sm-2">
            Developer
        </dt>
        <dd class="col-sm-10">
            @Model.Game.Developer?.Name
        </dd>
        <dt class = "col-sm-2">
            Genre
        </dt>
        <dd class = "col-sm-10">
            @Model.Game.Genre
        </dd>
        <dt class = "col-sm-2">
            Year
        </dt>
        <dd class = "col-sm-10">
            @Model.Game.Year
        </dd>
        <dt class = "col-sm-2">
            Score
        </dt>
        <dd class = "col-sm-10">
            @Model.Game.Score
        </dd>
        <dt class = "col-sm-2">
            Description
        </dt>
        <dd class = "col-sm-10">
            @Model.Game.Description
        </dd>
    </dl>
    <form method="post">
        <input type="hidden" asp-for="Game.Id" />
        <button type="submit" class="btn btn-danger">Delete</button> |
        <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
    </form>